# Domain is substituted by deploy script
__DOMAIN__ {
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # oauth2-proxy sign-in, callback and sign-out endpoints
    handle /oauth2/* {
        reverse_proxy 127.0.0.1:4180 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Uri {uri}
        }
    }

    # Everything else requires a GitHub sign-in (dimagi org). The gateway trusts
    # X-Forwarded-User, so drop any client-supplied identity headers first.
    handle {
        route {
            request_header -X-Forwarded-User
            request_header -X-Auth-Request-User
            request_header -X-Auth-Request-Email

            forward_auth 127.0.0.1:4180 {
                uri /oauth2/auth
                header_up X-Real-IP {remote_host}
                copy_headers X-Auth-Request-User X-Auth-Request-Email

                @unauthenticated status 401
                handle_response @unauthenticated {
                    redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
                }
            }

            reverse_proxy localhost:18789 {
                header_up X-Forwarded-User {http.request.header.X-Auth-Request-Email}
            }
        }
    }
}
